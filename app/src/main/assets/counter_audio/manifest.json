{
  "manifest_version": 2,
  "name": "VHB QMS Counter Audio Bridge",
  "version": "1.0.0",
  "description": "Local bridge that observes the VHB QMS counter display and forwards call state to the Android edge-audio runtime.",
  "browser_specific_settings": {
    "gecko": {
      "id": "counter-audio@vhb.vn"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
